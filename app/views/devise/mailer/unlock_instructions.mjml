<% content_for :title, t('.subject') %>

<mj-section background-color="#FFFFFF">
    <mj-column>
        <mj-text font-size="16px"><%= t('devise.mailer.hello_email', email: @resource.email) %></mj-text>
        <mj-text font-size="16px"><%= t('.content') %></mj-text>
    </mj-column>
</mj-section>
<mj-section>
    <mj-column width="100%">
        <mj-text font-size="16px"><%= t('.info') %></mj-text>
    </mj-column>
    <mj-button font-size="16px" border-radius="20px" background-color="#3498db" href="<%= unlock_url(@resource, unlock_token: @token) %>"><%= t('.button') %></mj-button>
</mj-section>
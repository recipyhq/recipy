<div class="uk-child-width-1-1@m" uk-grid>
  <div>
    <div class="uk-background-cover uk-height-medium uk-panel uk-flex uk-flex-center uk-flex-middle uk-background-fixed" uk-parallax="blur: 4" style="background-image: url(<%= url_for(@recipe.image.variant resize: '1000x1000') %>;"></div>
  </div>
</div>


<div class="uk-section uk-section-secondary uk-light">
    <div class="uk-container">
        <h2 class="title"><%= @recipe.title %></h2>
        <p><%= @recipe.description %></p>
        <div class="uk-child-width-1-3@m" uk-grid>
          <div>
            <div class="uk-text-center">
              <h5 class="title">Note</h5>
              <p><%= @recipe.score %> / 5</p>
            </div>
          </div>
          <div>
            <div class="uk-text-center">
              <h5 class="title">Temps</h5>
              <p><%= @recipe.cooking_time %></p>
            </div>
          </div>
          <div>
            <div class="uk-text-center">
              <h5 class="title">Difficulté</h5>
              <progress id="js-progressbar" class="uk-progress" value="<%= @recipe.difficulty %>" max="10"></progress>
            </div>
          </div>          
        </div>
    </div>
</div>

<div class="uk-section uk-section-default">
  <div class="uk-child-width-1-2@m" uk-grid>
    <div>
      <div class="uk-padding">
        <h2 class="title">Ingrédients</h2>
        <div class="uk-card uk-card-default uk-card-body">
          <%@recipe.recipe_ingredients.each do |recipe_ingredient| %>
              <div class="uk-grid-small" uk-grid>
                  <div class="uk-width-expand" uk-leader="fill: -"><%= recipe_ingredient.ingredient.name %></div>
                  <div><%= recipe_ingredient.recipe_quantity.value %> <%= recipe_ingredient.recipe_quantity.quantity_type.name %></div>
              </div>
          <% end %>
        </div>
      </div>
      <div  class="uk-padding">
        <h2 class="title">Ustensiles</h2>
        <div class="uk-card uk-card-default uk-card-body">
          <ul>
          <%@recipe.utensils.each do | ustensile| %>
            <li> <%= ustensile.title %></li>
          <% end %>
          </ul>
        </div>
      </div>
    </div>
    <div>
      <div class="uk-container uk-padding">
        <h2 class="title">Préparation</h2>
        <ul class="uk-list uk-list-bullet">
            <% @recipe.steps.each do |step| %>
              <li><%= step %></li>
            <% end %>
        </ul>
      </div>
    </div>
  </div>
</div>

<p id="notice"><%= notice %></p>
<%  if flash[:success] %>
  <div class="uk-alert-success" uk-alert>
    <a class="uk-alert-close" uk-close></a>
    <p><%= flash[:success] %></p>
  </div>
<% end %>

<div class="uk-section uk-section-secondary uk-light">
  <div class="uk-container">
    <h2 class="title">Donnez votre avis</h2>
    <% if user_signed_in? %>
      <div class="uk-child-width-1-2@m" uk-grid>
        <div>
          <%= simple_form_for :recipe_score,
              url: recipe_feedback_score_path(:recipe_id => @recipe.id),
              :method => :post,
              defaults: {
                wrapper: false,
                label: false
              } do |f| %>
            <div class="uk-margin">
              <%= f.input :value, :prompt => t("recipe.title.score"), :selected => @feedback_user.value, collection: 0..5, as: :select, input_html: { class: 'uk-select' } %>
            </div>
            <div>
              <%= f.button :submit, t("recipe.action.set_score") %>
            </div>
          <% end %>
        </div>
        <div>
          <%= simple_form_for :recipe_score,
                            url: recipe_feedback_comment_path(:recipe_id => @recipe.id),
                            :method => :post,
                            defaults: {
                              wrapper: false,
                            } do |f| %>
            <div class="uk-margin">
              <%= f.text_area :content, :label => t("recipe.title.comment"), :prompt => t("recipe.title.comment"), :value => @feedback_user.content, class: 'uk-textarea' %>
            </div>
            <div class="uk-margin">
              <%= f.button :submit, t("recipe.action.set_comment") %>
            </div>
          <% end %>
        </div>
      </div>
    <% else %>
      <a href="<%= new_user_session_path(:next => request.original_url) %>">Connectez-vous et donnez votre avis</a>
    <% end %>
  </div>
</div>

<div class="uk-section">
  <div class="uk-container">
    <h2 class="title"></h2>
    <% @recipe_feedbacks.each do |recipe_feedback| %>
      <article class="uk-comment">
        <header class="uk-comment-header uk-grid-medium uk-flex-middle" uk-grid>
            <div class="uk-width-auto">
                <img class="uk-comment-avatar" src="<%= url_for(recipe_feedback.user.avatar.variant resize: '200x200') %>" width="50" height="50" alt="">
            </div>
            <div class="uk-width-expand">
                <h4 class="uk-comment-title uk-margin-remove"><a class="uk-link-reset" href="#"><%= recipe_feedback.user.email %></a></h4>
                <ul class="uk-comment-meta uk-subnav uk-subnav-divider uk-margin-remove-top">
                    <li><%= recipe_feedback.updated_at.to_time.strftime('%m-%d-%Y %H:%M:%S') %></li>
                    <% if recipe_feedback.value %>
                      <li><%= recipe_feedback.value %> / 5</li>
                    <% end %>
                </ul>
            </div>
        </header>
        <% if recipe_feedback.content %>
          <div class="uk-comment-body">
            <p><%= recipe_feedback.content %></p>
          </div>
        <% end %>
    </article>
    <% end %>
  </div>
</div>

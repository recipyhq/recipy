<p id="notice"><%= notice %></p>
<div class="uk-text-center">
  <h1><%= "Recettes :" %></h1>
</div>
<%  if flash[:success] %>
  <div class="uk-alert-success" uk-alert>
    <a class="uk-alert-close" uk-close></a>
    <p><%= flash[:success] %></p>
  </div>
<% end %>
<div class="uk-child-width-1-2@s uk-child-width-1-3@m" uk-grid="masonry: true">
  <% @recipes.each do |recipe| %>
    <div class="uk-card uk-card-default uk-flex-center uk-flex-middle uk-card-body uk-text-center">
      <div>
        <%= link_to recipe.title , recipe, :class=>"uk-article-title uk-text-center" %>
      </div>
      <%= recipe.description %>
      <div class="uk-text-right">
        <%= recipe.time %> minutes
      </div>
      <%= link_to edit_recipe_path(recipe) do %>
        <i class="fas fa-edit"></i>
      <% end %>
      <%= link_to recipe, method: :delete, data: { confirm: t("recipe.action.confirm") } do %>
        <i class ="fa fa-lf fa-trash"></i>
      <% end %>
    </div>
  <% end %>
  <%= link_to  new_recipe_path , :class=>"uk-card uk-flex-center uk-flex-middle uk-card-body uk-text-left" do%>
    <i class="far fa-4x fa-plus-square"></i>
  <% end %>
</div>

<br>

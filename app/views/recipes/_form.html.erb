<%= stylesheet_link_tag 'https://cdnjs.cloudflare.com/ajax/libs/slim-select/1.18.7/slimselect.min.css' %>
<%= stylesheet_link_tag 'recipe_form' %>

<%= simple_form_for(@recipe, html: {
  class: "uk-padding recipe_form"
},) do |f| %>
  <%= f.error_notification %>
  <%= f.error_notification message: f.object.errors[:base].to_sentence if f.object.errors[:base].present? %>

  <%= f.input :title, label: t("recipe.title.title") %>
  <%= f.file_field :image %>
  <%= f.input :description, label: t("recipe.title.description") %>
  <%= f.simple_fields_for :new_recipe_ingredient do |ff| %>
    <%= ff.input :ingredients, :label => t("search.ingredient"), collection: Ingredient.all.map {|v| [v.name, v.id]}.to_a, as: :select, :include_blank => false, input_class: false, input_html: {id: "ingredients-select", multiple: true}, defaults: {input_class: ""} %>
    <%= ff.input :value, label: t("recipe.title.quantity_value") %>
    <%= ff.input :quantity_type, label: t("recipe.title.quantity_type"), as: :select, collection: QuantityType.all.map {|v| [v.name, v.id]}.to_a %>
  <% end %>
  <%= f.input :utensil_ids, :label => t("recipe.title.utensil"), collection: Utensil.all.map {|v| [v.title, v.id]}.to_a, as: :select, :include_blank => false, input_class: false, input_html: {id: "utensils-select", multiple: true}, defaults: {input_class: ""} %>
  <%= f.input :step, label: t("recipe.title.step") %>
  <%= f.label :difficulty, label: t("recipe.title.difficulty") %>
  <%= f.number_field :difficulty, max: 10, class: "uk-input" %>
  <%= f.input :cooking_time, label: t("recipe.title.time") %>
  <%= f.input :preparation_time, label: t("recipe.title.preparation_time") %>
  <%= f.input :person, label: t("recipe.title.nb_person") %>

  <div class="uk-margin-medium">
    <div class="uk-text-center">
      <%= f.button :submit, t("recipe.creation.confirm") %>
    </div>
  </div>
<% end %>

<script src="https://cdnjs.cloudflare.com/ajax/libs/slim-select/1.18.7/slimselect.min.js"></script>
<script>
  new SlimSelect({
    select: '#ingredients-select',
    searchingText: 'Recherche...',
    searchText: 'Désolé il n\'y a pas votre ingrédient dans la liste.',
    searchPlaceholder: 'Recherche ingrédient',
    placeholder: 'Ingrédients'
  });
  new SlimSelect({
    select: '#utensils-select',
    searchingText: 'Recherche...',
    searchText: 'Désolé il n\'y a pas l\'ustensile recherché dans la liste.',
    searchPlaceholder: 'Recherche ustensile',
    placeholder: 'Ustensiles'
  });
</script>

